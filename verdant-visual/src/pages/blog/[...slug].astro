---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
	);
	const toLink = (post?: CollectionEntry<'blog'>) =>
		post && { id: post.id, title: post.data.title };

	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: { post, newer: toLink(posts[index - 1]), older: toLink(posts[index + 1]) },
	}));
}

type PostLink = { id: string; title: string };
type Props = { post: CollectionEntry<'blog'>; newer?: PostLink; older?: PostLink };

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const wordCount = post.body?.trim().split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.round(wordCount / 220));
---

<BlogPost {...post.data} postId={post.id} readingTime={readingTime} newer={newer} older={older}>
	<Content />
</BlogPost>
