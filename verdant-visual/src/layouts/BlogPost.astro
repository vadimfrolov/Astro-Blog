---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import ReadingProgress from "../components/ReadingProgress.astro";

type Props = CollectionEntry<"blog">["data"] & {
  postId?: string;
  readingTime?: number;
};

const { title, description, pubDate, updatedDate, heroImage, postId, readingTime } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={heroImage} />
  </head>

  <body>
    <ReadingProgress />
    <Header />
    <main id="main" transition:animate="fade">
      <article>
        <div class="hero-image">
          <slot name="hero">
            {
              heroImage && (
                <Image
                  width={1020}
                  height={510}
                  src={heroImage}
                  alt=""
                  loading="eager"
                  fetchpriority="high"
                  transition:name={postId ? `blog-hero-${postId}` : undefined}
                />
              )
            }
          </slot>
        </div>
        <div class="prose">
          <div class="title">
            <p class="meta">
              <FormattedDate date={pubDate} />
              {
                readingTime && (
                  <>
                    <span class="meta-dot" aria-hidden="true">·</span>
                    <span>{readingTime} min read</span>
                  </>
                )
              }
            </p>
            <h1 transition:name={postId ? `blog-title-${postId}` : undefined}>{title}</h1>
            {
              updatedDate && (
                <p class="last-updated-on">
                  Last updated on <FormattedDate date={updatedDate} />
                </p>
              )
            }
          </div>
          <slot />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    width: auto;
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1rem 3rem;
  }
  .hero-image {
    max-width: 1020px;
    margin: 0 auto;
  }
  .hero-image img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }
  .prose {
    width: 720px;
    max-width: 100%;
    margin: 0 auto;
  }
  .title {
    margin-bottom: 2.5rem;
    padding: 2.5rem 0 2rem;
    border-bottom: 1px solid var(--border);
    text-align: center;
  }
  .title h1 {
    margin: 0;
    font-size: clamp(2rem, 1.5rem + 2.5vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    color: rgb(var(--gray));
    font-size: var(--font-size-sm);
    font-weight: 700;
    letter-spacing: var(--letter-spacing-wide);
  }
  .last-updated-on {
    margin: 1rem 0 0;
    color: rgb(var(--gray));
    font-size: var(--font-size-sm);
    font-style: italic;
  }

  @media (max-width: 720px) {
    main {
      padding: 1rem 1rem 2rem;
    }
    .title {
      margin-bottom: 2rem;
      padding: 2rem 0 1.5rem;
    }
  }
</style>
