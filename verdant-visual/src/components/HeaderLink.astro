---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const isActive = href === Astro.url.pathname;
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		padding: 1em 0.5em;
		position: relative;
		border-radius: 8px;
		transform-origin: center;
		overflow: hidden;
		z-index: 1;
		/* Remove unwanted selection styling */
		-webkit-tap-highlight-color: transparent;
		-webkit-touch-callout: none;
		-webkit-user-select: none;
		user-select: none;
		outline: none;
	}

	a:focus {
		outline: none;
		box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.3);
	}

	a:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
		border-radius: 8px;
	}

	a:focus:not(:focus-visible) {
		outline: none;
	}

	/* Remove any browser default selection */
	a::-moz-focus-inner {
		border: 0;
		padding: 0;
	}

	a.active {
		font-weight: 700;
		font-size: 1.12em;
		/* background: linear-gradient(135deg, rgba(102, 126, 234, 0.1), rgba(118, 75, 162, 0.05)); */
		box-shadow: 0 2px 12px rgba(102, 126, 234, 0.2);
		letter-spacing: 0.01em;
		position: relative;
		overflow: visible;
		color: var(--accent);
	}

    a.active:focus, a.active:focus-visible {
		box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.3), 0 2px 12px rgba(102, 126, 234, 0.2);
	}
</style>
