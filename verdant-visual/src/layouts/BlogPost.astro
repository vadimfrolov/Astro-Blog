---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import ReadingProgress from "../components/ReadingProgress.astro";

type PostLink = { id: string; title: string };

type Props = CollectionEntry<"blog">["data"] & {
  postId?: string;
  readingTime?: number;
  newer?: PostLink;
  older?: PostLink;
};

const { title, description, pubDate, updatedDate, heroImage, postId, readingTime, newer, older } =
  Astro.props;
const base = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={heroImage}
      article={{ publishedTime: pubDate, modifiedTime: updatedDate }}
    />
  </head>

  <body>
    <ReadingProgress />
    <Header />
    <main id="main" transition:animate="fade">
      <article>
        <header class="post-header">
          <a class="back" href={`${base}/blog`}>
            <span class="arrow arrow-back" aria-hidden="true">←</span> Blog
          </a>
          <h1 transition:name={postId ? `blog-title-${postId}` : undefined}>{title}</h1>
          <p class="meta">
            <FormattedDate date={pubDate} />
            {readingTime && <span>{readingTime} min read</span>}
            {
              updatedDate && (
                <span>
                  Updated <FormattedDate date={updatedDate} />
                </span>
              )
            }
          </p>
        </header>
        {
          heroImage && (
            <Image
              class="cover"
              src={heroImage}
              width={680}
              height={340}
              densities={[1, 2]}
              alt=""
              loading="eager"
              fetchpriority="high"
            />
          )
        }
        <div class="prose">
          <slot />
        </div>
        {
          (newer || older) && (
            <nav class="post-nav" aria-label="More posts">
              {older && (
                <a class="older" href={`${base}/blog/${older.id}/`}>
                  <span class="post-nav-label">
                    <span class="arrow arrow-back" aria-hidden="true">←</span> Older
                  </span>
                  <span class="post-nav-title">{older.title}</span>
                </a>
              )}
              {newer && (
                <a class="newer" href={`${base}/blog/${newer.id}/`}>
                  <span class="post-nav-label">
                    Newer <span class="arrow" aria-hidden="true">→</span>
                  </span>
                  <span class="post-nav-title">{newer.title}</span>
                </a>
              )}
            </nav>
          )
        }
      </article>
    </main>
    <Footer />
  </body>
</html>

<script>
  // Hover anchors for section headings and copy buttons for code blocks.
  function enhanceArticle() {
    document.querySelectorAll<HTMLElement>(".prose :is(h2, h3)[id]").forEach((heading) => {
      if (heading.querySelector(".heading-anchor")) return;
      const anchor = document.createElement("a");
      anchor.className = "heading-anchor";
      anchor.href = `#${heading.id}`;
      anchor.textContent = "#";
      anchor.tabIndex = -1;
      anchor.setAttribute("aria-hidden", "true");
      heading.prepend(anchor);
    });

    document.querySelectorAll<HTMLPreElement>(".prose pre").forEach((pre) => {
      if (pre.parentElement?.classList.contains("code-block")) return;
      const wrapper = document.createElement("div");
      wrapper.className = "code-block";
      pre.replaceWith(wrapper);
      wrapper.append(pre);

      const button = document.createElement("button");
      button.type = "button";
      button.className = "copy-button";
      button.textContent = "Copy";
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(pre.innerText.trimEnd());
          button.textContent = "Copied";
        } catch {
          button.textContent = "Copy failed";
        }
        setTimeout(() => (button.textContent = "Copy"), 1600);
      });
      wrapper.append(button);
    });
  }

  document.addEventListener("astro:page-load", enhanceArticle);
</script>

<style>
  .post-header {
    margin-bottom: 2.5rem;
  }
  .back {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .back:hover {
    color: var(--fg);
  }
  .post-header h1 {
    margin-bottom: 0.875rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
  .meta > :not(:first-child)::before {
    content: "";
    display: inline-block;
    width: 3px;
    height: 3px;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: currentColor;
    vertical-align: middle;
  }

  .cover {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: 2.75rem;
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .post-nav a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .post-nav .newer {
    grid-column: 2;
    text-align: right;
  }
  .post-nav-label {
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .post-nav-title {
    color: var(--fg);
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .post-nav a:hover .post-nav-title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }

  @media (max-width: 560px) {
    .post-nav {
      grid-template-columns: 1fr;
    }
    .post-nav .newer {
      grid-column: 1;
      grid-row: 1;
    }
  }
</style>
