---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const isActive = href === Astro.url.pathname;
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
		transition: color 0.2s ease, text-decoration 0.2s ease, outline 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
		/* border-radius: 4px; */
		padding: 4px 8px;
		margin: -4px -8px;
	}
	
	a:hover {
		text-decoration: underline;
		text-decoration-thickness: 3px;
		text-underline-offset: 4px;
	}
	
	a:focus {
		outline: 2px solid currentColor;
		outline-offset: 2px;
	}
	
	a:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 2px;
	}
	
	a:focus:not(:focus-visible) {
		outline: none;
	}
	
	a.active {
		font-weight: bolder;
		font-size: 1.15em;
		text-decoration: underline;
		/* border-radius: 8px; */
		background-color: #fffde7;
		box-shadow: 0 2px 8px 0 rgba(25, 118, 210, 0.12);
		color: #f57c00;
		position: relative;
		z-index: 1;
	}

    a.active:focus, a.active:focus-visible {
	background-color: #bbdefb;
	box-shadow: 0 0 0 3px #90caf9, 0 2px 8px 0 rgba(25, 118, 210, 0.12);
	}
</style>
