---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const base = import.meta.env.BASE_URL;
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
	<div class="inner">
		<a class="brand" href={`${base}/`}>
			<svg class="brand-mark" viewBox="0 0 32 32" width="22" height="22" aria-hidden="true">
				<rect width="32" height="32" rx="7" fill="#0d0d0d"></rect>
				<rect class="brand-dot" x="7" y="7" width="8" height="8" fill="#2a8fbd"></rect>
				<rect x="7" y="19" width="18" height="3" rx="1.5" fill="#f5f5f5"></rect>
			</svg>
			<span>{SITE_TITLE}</span>
		</a>
		<nav aria-label="Main">
			<HeaderLink href={`${base}/blog`}>Blog</HeaderLink>
			<HeaderLink href={`${base}/about`}>About</HeaderLink>
		</nav>
	</div>
</header>

<style>
	.skip-link {
		position: absolute;
		top: 0.75rem;
		left: 0.75rem;
		z-index: 200;
		padding: 0.5rem 0.875rem;
		border-radius: 6px;
		background: var(--fg);
		color: #fff;
		font-size: 0.875rem;
		transform: translateY(-200%);
	}
	.skip-link:focus {
		transform: none;
	}

	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		max-width: calc(var(--column) + 2 * var(--gutter));
		margin: 0 auto;
		padding: 1.75rem var(--gutter) 0;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		color: var(--fg);
		font-weight: 700;
		letter-spacing: -0.01em;
	}
	.brand-mark {
		flex: none;
		border-radius: 5px;
	}
	.brand-dot {
		transform-box: fill-box;
		transform-origin: center;
		transition: transform 0.6s var(--ease);
	}
	.brand:hover .brand-dot {
		transform: rotate(90deg);
	}

	nav {
		display: flex;
		gap: 1.5rem;
	}
</style>
