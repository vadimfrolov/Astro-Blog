---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

const normalize = (path: string) => path.replace(/\/+$/, '') || '/';
const home = normalize(import.meta.env.BASE_URL);
const target = normalize(String(href));
const current = normalize(Astro.url.pathname);
const isActive =
	target === home ? current === home : current === target || current.startsWith(`${target}/`);
---

<a
	href={href}
	class:list={[className, { active: isActive }]}
	aria-current={isActive ? 'page' : undefined}
	{...props}
>
	<slot />
</a>

<style>
	a {
		position: relative;
		color: var(--muted);
		font-size: 0.9375rem;
	}
	a:hover,
	a.active {
		color: var(--fg);
	}
	a.active::after {
		content: '';
		position: absolute;
		left: 50%;
		bottom: -0.5rem;
		width: 4px;
		height: 4px;
		background: var(--accent);
		transform: translateX(-50%);
	}
</style>
