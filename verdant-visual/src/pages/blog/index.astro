---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import PostList from "../../components/PostList.astro";
import { SITE_TITLE } from "../../consts";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Group posts by year, newest first
const years = Map.groupBy(posts, (post) => post.data.pubDate.getFullYear());
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Blog | ${SITE_TITLE}`}
      description="Articles on AI, web development, and accessibility."
    />
  </head>
  <body>
    <Header />
    <main id="main" transition:animate="fade">
      <header class="page-header">
        <h1>Blog</h1>
        <p>Articles on AI, web development, and accessibility.</p>
      </header>
      {
        [...years].map(([year, yearPosts]) => (
          <section class="year" aria-labelledby={`year-${year}`}>
            <h2 id={`year-${year}`} class="label">
              {year}
            </h2>
            <PostList posts={yearPosts} withYear={false} />
          </section>
        ))
      }
    </main>
    <Footer />
  </body>
</html>

<style>
  .page-header {
    margin-bottom: 3.5rem;
  }
  .page-header h1 {
    margin-bottom: 0.5rem;
  }
  .page-header p {
    margin: 0;
    color: var(--muted);
  }
  .year + .year {
    margin-top: 3rem;
  }
  .year .label {
    margin-bottom: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
</style>
