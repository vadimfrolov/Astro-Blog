---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

// Get the 3 most recent blog posts
const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				padding: 4rem 0 3rem;
				text-align: center;
			}

			.hero h1 {
				font-size: var(--font-size-5xl);
				font-weight: 800;
				line-height: var(--line-height-tight);
				margin-bottom: 1rem;
				background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
				animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
				opacity: 0;
				animation-fill-mode: forwards;
			}

			.hero .subtitle {
				font-size: var(--font-size-xl);
				color: rgb(var(--gray-dark));
				margin-bottom: 2rem;
				max-width: 600px;
				margin-left: auto;
				margin-right: auto;
				animation: fadeInUp 0.6s 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
				opacity: 0;
				animation-fill-mode: forwards;
			}

			.cta-buttons {
				display: flex;
				gap: 1rem;
				justify-content: center;
				flex-wrap: wrap;
				margin-top: 2rem;
				animation: fadeInUp 0.6s 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
				opacity: 0;
				animation-fill-mode: forwards;
			}

			@keyframes fadeInUp {
				from {
					opacity: 0;
					transform: translateY(30px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}



			.btn {
				padding: 0.75rem 2rem;
				border-radius: 0.5rem;
				text-decoration: none;
				font-weight: 600;
				transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
				display: inline-block;
				position: relative;
				overflow: hidden;
				transform-origin: center;
			}

			.btn::before {
				content: '';
				position: absolute;
				top: 50%;
				left: 50%;
				width: 0;
				height: 0;
				border-radius: 50%;
				background: rgba(255, 255, 255, 0.3);
				transform: translate(-50%, -50%);
				transition: width 0.35s cubic-bezier(0.4, 0, 0.2, 1), height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
			}

			.btn:hover::before {
				width: 300px;
				height: 300px;
			}

			.btn-primary {
				background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
				color: white;
				border: none;
			}

			.btn-primary:hover {
				transform: translateY(-3px) scale(1.05);
				box-shadow: 0 15px 30px rgba(102, 126, 234, 0.4);
			}

			.btn-primary:active {
				transform: translateY(-1px) scale(1.02);
			}

			.btn-secondary {
				background: transparent;
				color: #667eea;
				border: 2px solid #667eea;
			}

			.btn-secondary:hover {
				background: #667eea;
				color: white;
				transform: translateY(-3px) scale(1.05);
				box-shadow: 0 15px 30px rgba(102, 126, 234, 0.3);
			}

			.btn-secondary:active {
				transform: translateY(-1px) scale(1.02);
			}

			.section {
				padding: 3rem 0;
			}

			.section-title {
				font-size: var(--font-size-3xl);
				font-weight: 700;
				margin-bottom: 2rem;
				text-align: center;
				color: rgb(var(--black));
			}

			.posts-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
				gap: 2rem;
				margin-top: 2rem;
			}

			.post-card {
				background: white;
				border-radius: 0.75rem;
				padding: 1.5rem;
				border: 1px solid #e5e7eb;
				transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
				text-decoration: none;
				color: inherit;
				display: block;
				position: relative;
				overflow: hidden;
				transform-origin: center;
			}

			.post-card::before {
				content: '';
				position: absolute;
				top: 0;
				left: -100%;
				width: 100%;
				height: 100%;
				background: linear-gradient(90deg, transparent, rgba(102, 126, 234, 0.1), transparent);
				transition: left 0.35s cubic-bezier(0.4, 0, 0.2, 1);
			}

			.post-card:hover::before {
				left: 100%;
			}

			.post-card:hover {
				transform: translateY(-8px) scale(1.02);
				box-shadow: 0 20px 40px rgba(102, 126, 234, 0.15);
				border-color: #667eea;
			}

			.post-card:active {
				transform: translateY(-4px) scale(1.01);
				transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
			}

			.post-date {
				color: rgb(var(--gray));
				font-size: var(--font-size-sm);
				margin-bottom: 0.5rem;
				font-weight: 500;
			}

			.post-title {
				font-size: var(--font-size-lg);
				font-weight: 600;
				margin-bottom: 0.5rem;
				color: rgb(var(--black));
				line-height: var(--line-height-snug);
			}

			.post-excerpt {
				color: rgb(var(--gray));
				line-height: var(--line-height-relaxed);
				font-size: var(--font-size-sm);
			}

			.skills {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				justify-content: center;
				margin-top: 2rem;
			}

			.skill-tag {
				background: #f3f4f6;
				padding: 0.5rem 1rem;
				border-radius: 2rem;
				font-size: 0.875rem;
				color: #4b5563;
				border: 1px solid #e5e7eb;
			}

			.about-section {
				max-width: 700px;
				margin: 0 auto;
				text-align: center;
				line-height: 1.8;
				color: #4b5563;
			}

			@media (max-width: 768px) {
				.hero h1 {
					font-size: var(--font-size-4xl);
				}

				.posts-grid {
					grid-template-columns: 1fr;
				}
			}

			@keyframes fadeInUp {
				from {
					opacity: 0;
					transform: translateY(30px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main transition:animate="fade">
			<!-- Hero Section -->
			<section class="hero">
				<h1>Hi, I'm Vadim 👋</h1>
				<p class="subtitle">
					I'm a software developer based in <b>Berlin</b>, Germany with my wife and dog. I write this blog and share insights on web development, coding tips, and anything I find important to talk about.
				</p>
				<div class="cta-buttons">
					<a href={`${import.meta.env.BASE_URL}/blog`} class="btn btn-primary">Read My Blog</a>
					<a href={`${import.meta.env.BASE_URL}/about`} class="btn btn-secondary">About Me</a>
				</div>
			</section>

			<!-- Latest Posts Section -->
			<section class="section">
				<h2 class="section-title">Latest Posts</h2>
				<div class="posts-grid">
					{posts.map((post) => (
						<a href={`${import.meta.env.BASE_URL}/blog/${post.id}/`} class="post-card" transition:animate="slide">
							<div class="post-date">
								{new Date(post.data.pubDate).toLocaleDateString('en-us', {
									year: 'numeric',
									month: 'short',
									day: 'numeric'
								})}
							</div>
							<h3 class="post-title" transition:name={`blog-title-${post.id}`}>{post.data.title}</h3>
							<p class="post-excerpt">{post.data.description}</p>
						</a>
					))}
				</div>
			</section>


		</main>
		<Footer />
	</body>
</html>
