---
const today = new Date();
---

<footer class="site-footer">
	<div class="inner">
		<p>&copy; {today.getFullYear()} Vadim Frolov</p>
		<nav aria-label="Social">
			<a href="https://www.linkedin.com/in/vadimfrolovconcrete/" target="_blank" rel="noopener noreferrer">
				LinkedIn <span class="arrow arrow-ne" aria-hidden="true">↗</span>
			</a>
			<a href="https://x.com/viceversa_de" target="_blank" rel="noopener noreferrer">
				X <span class="arrow arrow-ne" aria-hidden="true">↗</span>
			</a>
		</nav>
	</div>
</footer>

<style>
	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		max-width: calc(var(--column) + 2 * var(--gutter));
		margin: 0 auto;
		padding: 0 var(--gutter) 3rem;
		color: var(--muted);
		font-size: 0.875rem;
	}
	.inner::before {
		content: '';
		flex-basis: 100%;
		margin-bottom: 1.25rem;
		border-top: 1px solid var(--line);
	}
	p {
		margin: 0;
	}
	nav {
		display: flex;
		gap: 1.25rem;
	}
	a:hover {
		color: var(--fg);
	}
</style>
