---
import { Image } from 'astro:assets';
import AboutHeroImage from '../assets/about-me.webp';
import AboutAvatar from '../assets/about-avatar.webp';
import Layout from '../layouts/BlogPost.astro';
---

<Layout
	title="About Me"
	description="About Vadim Frolov"
	pubDate={new Date('October 19 2025')}
	heroImage={AboutHeroImage}
>
	<div slot="hero" class="about-hero">
		<div class="about-hero-text">
			<span class="about-hero-accent" aria-hidden="true"></span>
			<h2>Hey my name is Vadim</h2>
			<p>I like coffee, movies, hiking and clear acceptance criteria</p>
		</div>
		<Image class="about-hero-avatar" src={AboutAvatar} width={420} height={410} alt="Portrait of Vadim" />
	</div>

	<p>
		Hi! I'm Vadim, a Software Engineer since 2018. This is my personal website where I like to 
		share my thoughts.
	</p>

	<p>
		I'm passionate about learning and I like to share. I enjoy talking 
		and listening to people, building prototypes, and solving complex problems.
	</p>

	<h3>What I'm up to:</h3>
	<ul>
		<li>💻 Currently working at <a href="https://www.distribusion.com/" target="_blank" rel="noopener noreferrer">Distribusion</a></li>
		<li>🐕 Proud corgi owner</li>
		<li>🎞️ Movie enthusiast - I know a lot about movies</li>
	</ul>

	<p>
		Fun fact: Before diving into web development, I worked as a Civil Engineer for over 7 years. 
		That experience taught me the importance of solid foundations.
	</p>

	<p>
		I love connecting with fellow developers, movie nerds, and anyone interested in technology. 
		Feel free to reach out if you'd like to chat about code, movies, or anything in between!
	</p>
</Layout>

<style>
	.about-hero {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		min-height: 320px;
		padding: 3rem clamp(1.5rem, 5vw, 4rem);
		border-radius: 12px;
		background: #0b0b0b;
		box-shadow: var(--box-shadow);
		color: #f5f5f5;
		font-family: "Atkinson", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
	}

	.about-hero-text {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.about-hero-avatar {
		flex: 0 1 260px;
		width: 260px;
		height: auto;
	}

	.about-hero-accent {
		display: block;
		width: 1.25rem;
		height: 1.25rem;
		background: #2a8fbd;
	}

	.about-hero h2 {
		margin: 0;
		font-size: clamp(2rem, 1.5rem + 3vw, 3.5rem);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -0.025em;
	}

	.about-hero p {
		margin: 0;
		max-width: 28ch;
		font-size: clamp(1.125rem, 1rem + 0.8vw, 1.5rem);
		line-height: 1.4;
		color: #d4d4d4;
	}
</style>

