---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Avatar from '../assets/avatar.webp';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL;

// Get the 3 most recent blog posts
const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main id="main" transition:animate="fade">
			<section class="intro">
				<Image
					class="avatar"
					src={Avatar}
					width={64}
					height={64}
					densities={[1, 2]}
					alt="Portrait of Vadim Frolov"
					loading="eager"
				/>
				<h1>Hi, I'm Vadim <span class="wave" aria-hidden="true">👋</span></h1>
				<p class="bio">
					I'm a software developer based in <b>Berlin</b>, Germany with my dog. I write this blog and share insights on web development, coding tips, and anything I find important to talk about.
				</p>
				<a class="more" href={`${base}/about`}>More about me <span class="arrow" aria-hidden="true">→</span></a>
			</section>

			<section class="latest" aria-labelledby="latest-title">
				<div class="section-head">
					<h2 id="latest-title" class="label">Latest posts</h2>
					<a class="more" href={`${base}/blog`}>All posts <span class="arrow" aria-hidden="true">→</span></a>
				</div>
				<PostList posts={posts} />
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro > * {
		animation: enter 0.7s var(--ease) both;
	}
	.intro > :nth-child(2) {
		animation-delay: 0.06s;
	}
	.intro > :nth-child(3) {
		animation-delay: 0.12s;
	}
	.intro > :nth-child(4) {
		animation-delay: 0.18s;
	}

	.avatar {
		display: block;
		width: 64px;
		height: 64px;
		margin-bottom: 1.75rem;
		border-radius: 50%;
		box-shadow: 0 0 0 1px var(--line);
	}

	h1 {
		margin-bottom: 0.75rem;
	}
	.wave {
		display: inline-block;
		transform-origin: 70% 70%;
	}
	h1:hover .wave {
		animation: wave 1.2s ease-in-out;
	}

	.bio {
		max-width: 36rem;
		margin-bottom: 1.25rem;
	}

	.more {
		color: var(--muted);
		font-size: 0.9375rem;
	}
	.more:hover {
		color: var(--fg);
	}

	.latest {
		margin-top: 4.5rem;
	}
	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.75rem;
	}
	.section-head .more {
		font-size: 0.875rem;
	}

	@keyframes enter {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	@keyframes wave {
		0%,
		100% {
			transform: rotate(0deg);
		}
		15%,
		45% {
			transform: rotate(14deg);
		}
		30% {
			transform: rotate(-8deg);
		}
		60% {
			transform: rotate(-4deg);
		}
		75% {
			transform: rotate(10deg);
		}
	}

	@media (max-width: 720px) {
		.latest {
			margin-top: 3.5rem;
		}
	}
</style>
