---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SocialLinks from './SocialLinks.astro';

const base = import.meta.env.BASE_URL;
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
	<nav class="nav" aria-label="Main">
		<a class="brand" href={`${base}/`}>
			<svg class="brand-mark" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
				<defs>
					<linearGradient id="brand-gradient" x1="0" y1="0" x2="1" y2="1">
						<stop offset="0" stop-color="#4f46e5"></stop>
						<stop offset="1" stop-color="#7c3aed"></stop>
					</linearGradient>
				</defs>
				<rect width="32" height="32" rx="8" fill="url(#brand-gradient)"></rect>
				<path d="M8 13h12v4.5a5.5 5.5 0 0 1-5.5 5.5h-1A5.5 5.5 0 0 1 8 17.5V13Z" fill="#fff"></path>
				<path
					d="M20 14.5h1.5a2.75 2.75 0 0 1 0 5.5H20M7 25.5h15M12 6c-1 1 1 2 0 3.5M16 6c-1 1 1 2 0 3.5"
					fill="none"
					stroke="#fff"
					stroke-width="1.8"
					stroke-linecap="round"></path>
			</svg>
			<span class="brand-name">{SITE_TITLE}</span>
		</a>
		<div class="nav-links">
			<HeaderLink href={`${base}/`}>Home</HeaderLink>
			<HeaderLink href={`${base}/blog`}>Blog</HeaderLink>
			<HeaderLink href={`${base}/about`}>About</HeaderLink>
		</div>
		<div class="nav-social">
			<SocialLinks />
		</div>
	</nav>
</header>

<script>
	const syncHeader = () => {
		document.querySelector('.site-header')?.toggleAttribute('data-scrolled', window.scrollY > 8);
	};
	window.addEventListener('scroll', syncHeader, { passive: true });
	document.addEventListener('astro:page-load', syncHeader);
</script>

<style>
	.skip-link {
		position: absolute;
		top: 0.75rem;
		left: 0.75rem;
		z-index: 200;
		padding: 0.5rem 1rem;
		border-radius: var(--radius-sm);
		background: rgb(var(--black));
		color: #fff;
		font-weight: 700;
		transform: translateY(-200%);
	}
	.skip-link:focus {
		transform: none;
		color: #fff;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		border-bottom: 1px solid rgba(var(--gray-light), 0.9);
		background: rgba(255, 255, 255, 0.82);
		-webkit-backdrop-filter: saturate(180%) blur(12px);
		backdrop-filter: saturate(180%) blur(12px);
		transition: box-shadow var(--transition-base);
	}
	.site-header[data-scrolled] {
		box-shadow: 0 6px 24px -16px rgba(var(--black), 0.35);
	}

	.nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
		max-width: 1080px;
		height: var(--header-height);
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		justify-self: start;
		color: rgb(var(--black));
		font-size: 1.0625rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}
	.brand:hover {
		color: var(--accent);
	}
	.brand-mark {
		flex: none;
		border-radius: 8px;
		box-shadow: 0 2px 6px -1px rgba(79, 70, 229, 0.45);
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.nav-social {
		justify-self: end;
	}

	@media (max-width: 720px) {
		.nav {
			display: flex;
			justify-content: space-between;
			padding: 0 1rem;
		}
		.nav-social {
			display: none;
		}
	}

	@media (max-width: 389px) {
		.brand-name {
			display: none;
		}
	}
</style>
