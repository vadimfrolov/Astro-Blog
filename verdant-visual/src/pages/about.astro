---
import { Image } from 'astro:assets';
import AboutHeroImage from '../assets/about-me.webp';
import AboutAvatar from '../assets/about-avatar.webp';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description="About Vadim Frolov" image={AboutHeroImage} />
	</head>
	<body>
		<Header />
		<main id="main" transition:animate="fade">
			<div class="about-hero">
				<div class="about-hero-text">
					<span class="about-hero-accent" aria-hidden="true"></span>
					<h1>Hey my name is Vadim</h1>
					<p>I like coffee, movies, hiking and clear acceptance criteria</p>
				</div>
				<Image
					class="about-hero-avatar"
					src={AboutAvatar}
					width={220}
					height={215}
					densities={[1, 2]}
					alt="Portrait of Vadim"
					loading="eager"
				/>
			</div>

			<div class="prose">
				<p>
					Hi! I'm Vadim, a Software Engineer since 2018. This is my personal website where I like to 
					share my thoughts.
				</p>

				<p>
					I'm passionate about learning and I like to share. I enjoy talking 
					and listening to people, building prototypes, and solving complex problems.
				</p>

				<h2>What I'm up to:</h2>
				<ul class="emoji-list">
					<li>💻 Currently working at <a href="https://www.distribusion.com/" target="_blank" rel="noopener noreferrer">Distribusion</a></li>
					<li>🐕 Proud corgi owner</li>
					<li>🎞️ Movie enthusiast - I know a lot about movies</li>
				</ul>

				<p>
					Fun fact: Before diving into web development, I worked as a Civil Engineer for over 7 years. 
					That experience taught me the importance of solid foundations.
				</p>

				<p>
					I love connecting with fellow developers, movie nerds, and anyone interested in technology. 
					Feel free to reach out if you'd like to chat about code, movies, or anything in between!
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about-hero {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem 2rem;
		margin-bottom: 3rem;
		padding: 2.5rem clamp(1.5rem, 5vw, 2.5rem);
		border-radius: 12px;
		background: #0d0d0d;
		color: #f5f5f5;
	}

	.about-hero-text {
		display: flex;
		flex: 1 1 260px;
		flex-direction: column;
		gap: 0.875rem;
	}

	.about-hero-avatar {
		flex: 0 1 200px;
		width: 200px;
		min-width: 0;
		max-width: 100%;
		height: auto;
		/* Melts the photo's near-black backdrop into the card */
		mix-blend-mode: lighten;
	}

	.about-hero-accent {
		display: block;
		width: 1rem;
		height: 1rem;
		background: var(--accent);
	}

	.about-hero h1 {
		margin: 0;
		color: #f5f5f5;
		font-size: clamp(1.875rem, 1.4rem + 2vw, 2.5rem);
		line-height: 1.1;
		letter-spacing: -0.025em;
	}

	.about-hero p {
		margin: 0;
		max-width: 28ch;
		color: #d4d4d4;
		font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
		line-height: 1.4;
	}

	.emoji-list {
		padding-left: 0;
		list-style: none;
	}
	.emoji-list li {
		padding-left: 0;
	}

	@media (max-width: 640px) {
		.about-hero {
			justify-content: center;
			padding: 2rem 1.5rem 0;
		}
		.about-hero-text {
			flex-basis: 100%;
		}
		.about-hero-avatar {
			flex-basis: 200px;
		}
	}
</style>
