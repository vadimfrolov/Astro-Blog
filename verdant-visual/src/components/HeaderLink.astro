---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

const normalize = (path: string) => path.replace(/\/+$/, '') || '/';
const home = normalize(import.meta.env.BASE_URL);
const target = normalize(String(href));
const current = normalize(Astro.url.pathname);
const isActive =
	target === home ? current === home : current === target || current.startsWith(`${target}/`);
---

<a
	href={href}
	class:list={[className, { active: isActive }]}
	aria-current={isActive ? 'page' : undefined}
	{...props}
>
	<slot />
</a>

<style>
	a {
		display: inline-flex;
		align-items: center;
		padding: 0.45rem 0.85rem;
		border-radius: 999px;
		color: rgb(var(--gray-dark));
		font-size: 0.9375rem;
		line-height: 1.25;
		white-space: nowrap;
	}
	a:hover {
		color: rgb(var(--black));
		background-color: rgba(var(--gray-light), 0.8);
	}
	a.active {
		color: var(--accent);
		background-color: var(--accent-soft);
		font-weight: 700;
	}

	@media (max-width: 720px) {
		a {
			padding: 0.45rem 0.7rem;
		}
	}
</style>
