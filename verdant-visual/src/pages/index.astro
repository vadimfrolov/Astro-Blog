---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Avatar from '../assets/avatar.webp';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL;

// Get the 3 most recent blog posts
const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main id="main" transition:animate="fade">
			<section class="intro">
				<div class="avatar-wrap" data-tilt>
					<Image
						class="avatar"
						src={Avatar}
						width={64}
						height={64}
						densities={[1, 2]}
						alt="Portrait of Vadim Frolov"
						loading="eager"
					/>
				</div>
				<h1>Hi, I'm Vadim <span class="wave" aria-hidden="true">👋</span></h1>
				<p class="bio">
					I'm a software developer living in <b>Berlin</b>, Germany, with my dog. I write this blog and share insights on web development, coding tips, and anything I find important to talk about.
				</p>
				<a class="more" href={`${base}/about`}>More about me <span class="arrow" aria-hidden="true">→</span></a>
			</section>

			<section class="latest" aria-labelledby="latest-title">
				<div class="section-head">
					<h2 id="latest-title" class="label">Latest posts</h2>
					<a class="more" href={`${base}/blog`}>All posts <span class="arrow" aria-hidden="true">→</span></a>
				</div>
				<PostList posts={posts} />
			</section>
		</main>
		<Footer />
	</body>
</html>

<script>
	// The avatar leans toward the pointer; skipped on touch screens and for reduced motion.
	function initAvatarTilt() {
		const wrap = document.querySelector<HTMLElement>('[data-tilt]');
		if (!wrap || wrap.dataset.tiltReady) return;
		if (!matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) return;
		wrap.dataset.tiltReady = 'true';

		wrap.addEventListener('pointermove', (event) => {
			const rect = wrap.getBoundingClientRect();
			const x = (event.clientX - rect.left) / rect.width - 0.5;
			const y = (event.clientY - rect.top) / rect.height - 0.5;
			wrap.style.setProperty('--rx', `${(-y * 24).toFixed(1)}deg`);
			wrap.style.setProperty('--ry', `${(x * 24).toFixed(1)}deg`);
			wrap.style.setProperty('--tx', `${(x * 6).toFixed(1)}px`);
			wrap.style.setProperty('--ty', `${(y * 6).toFixed(1)}px`);
		});
		wrap.addEventListener('pointerleave', () => {
			for (const prop of ['--rx', '--ry', '--tx', '--ty']) wrap.style.removeProperty(prop);
		});
	}

	document.addEventListener('astro:page-load', initAvatarTilt);
</script>

<style>
	.intro > * {
		animation: enter 0.7s var(--ease) both;
	}
	.intro > :nth-child(2) {
		animation-delay: 0.06s;
	}
	.intro > :nth-child(3) {
		animation-delay: 0.12s;
	}
	.intro > :nth-child(4) {
		animation-delay: 0.18s;
	}

	.avatar-wrap {
		width: 64px;
		height: 64px;
		margin-bottom: 1.75rem;
		perspective: 240px;
	}
	.avatar {
		display: block;
		width: 64px;
		height: 64px;
		border-radius: 50%;
		box-shadow: 0 0 0 1px var(--line);
		transform: translate(var(--tx, 0px), var(--ty, 0px)) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
		transition:
			transform 0.6s var(--ease),
			box-shadow 0.3s var(--ease);
	}
	.avatar-wrap:hover .avatar {
		box-shadow:
			0 0 0 3px var(--bg),
			0 0 0 4.5px var(--accent),
			0 14px 24px -14px rgb(24 24 27 / 0.5);
		transform: translate(var(--tx, 0px), var(--ty, 0px)) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) scale(1.08);
		transition:
			transform 0.2s ease-out,
			box-shadow 0.3s var(--ease);
	}

	h1 {
		margin-bottom: 0.75rem;
	}
	.wave {
		display: inline-block;
		transform-origin: 70% 70%;
	}
	/* Hovering the avatar or the greeting makes the hand wave */
	h1:hover .wave,
	.intro:has(.avatar-wrap:hover) .wave {
		animation: wave 1.2s ease-in-out;
	}

	.bio {
		max-width: 36rem;
		margin-bottom: 1.25rem;
	}

	.more {
		color: var(--muted);
		font-size: 0.9375rem;
	}
	.more:hover {
		color: var(--fg);
	}

	.latest {
		margin-top: 4.5rem;
	}
	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.75rem;
	}
	.section-head .more {
		font-size: 0.875rem;
	}

	@keyframes enter {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	@keyframes wave {
		0%,
		100% {
			transform: rotate(0deg);
		}
		15%,
		45% {
			transform: rotate(14deg);
		}
		30% {
			transform: rotate(-8deg);
		}
		60% {
			transform: rotate(-4deg);
		}
		75% {
			transform: rotate(10deg);
		}
	}

	@media (max-width: 720px) {
		.latest {
			margin-top: 3.5rem;
		}
	}
</style>
